# Public URL of the site (used in WhatsApp product links, SEO and sitemaps)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Password for /admin. Admin login is disabled when this is empty.
ADMIN_PASSWORD=change-me

# Random secret used to sign admin sessions (any long random string)
ADMIN_SESSION_SECRET=

# Where products, orders and uploaded images are stored (default: ./data)
# DATA_DIR=/var/lib/fashion-hub

# "firestore" to use Firestore + Firebase Storage (set automatically on Firebase App Hosting).
# Leave unset to store data in DATA_DIR.
# DATA_STORE=firestore
